# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (no trailing slash). Required in production.
CLIENT_URL=http://localhost:5173
# Public URL of the frontend (used for sitemap.xml)
SITE_URL=http://localhost:5173
# Set to 1 when behind a proxy such as Render/Railway/Nginx (needed for correct rate-limit IPs)
TRUST_PROXY=1

# ---- MongoDB ----
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name. If your URI already contains a db name you may leave this empty.
MONGO_DB_NAME=ivy_interio
MONGO_MAX_POOL_SIZE=10

# ---- Auth ----
# At least 32 random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

# ---- First admin (used ONLY by `npm run create-admin`, and by first login when no admin exists yet) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password-12chars+
# Remove ADMIN_PASSWORD from the hosting dashboard once the admin exists in the database.

# On start-up, add starter content ONLY for content types that have no records (never overwrites). Set false to disable.
AUTO_SEED=true

# ---- Optional: Cloudinary (persistent image uploads). Leave blank to disable uploads. ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ivy-interio
