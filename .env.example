# Frontend (Vite). Only variables prefixed with VITE_ are exposed to the browser. NEVER put secrets here.
# Leave empty in local dev (Vite proxies /api to http://localhost:5000).
# In production set to the public URL of the deployed Express API, no trailing slash, e.g.:
# VITE_API_URL=https://ivy-interio-api.onrender.com
VITE_API_URL=
